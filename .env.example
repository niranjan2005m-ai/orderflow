# ============================================================
# ORDERFLOW – Environment variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow_secret
POSTGRES_DB=orderflow

# gRPC service addresses (use Docker service names inside compose)
INVENTORY_SERVICE_ADDR=inventory-service:50052
ORDER_SERVICE_ADDR=order-service:50051

# Kafka (KRaft, single-node, no Zookeeper)
KAFKA_BROKER=kafka:9092
KAFKA_CLIENT_ID=orderflow

# Gateway
GATEWAY_PORT=4000

# Service ports
ORDER_SERVICE_PORT=50051
INVENTORY_SERVICE_PORT=50052
